# Database (docker-compose exposes Postgres on 5434 locally to avoid
# clashing with other local Postgres instances; adjust for staging/prod)
DATABASE_URL="postgresql://admin:admin@localhost:5434/inventory"

# NextAuth
NEXTAUTH_URL="http://localhost:4200"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# App
APP_URL="http://localhost:4200"
NEXT_PUBLIC_APP_URL="http://localhost:4200"

# AI — routed through the Vercel AI Gateway (see lib/ai/provider.ts). Not
# needed when deployed on Vercel, which authenticates via OIDC automatically;
# required for local dev. Get one from vercel.com/dashboard -> AI Gateway.
AI_GATEWAY_API_KEY=""

# MCP server auth — bearer token required on the HTTP MCP endpoint (pages/api/mcp.ts)
MCP_SERVER_TOKEN="replace-with-a-long-random-token"

# Autonomous agent guardrails (see lib/ai/policy.ts) — hard ceiling regardless
# of per-team AgentPolicy configuration.
AGENT_MAX_AUTO_REORDER_AMOUNT="2000"
