# Database (docker-compose exposes Postgres on 5434 locally to avoid
# clashing with other local Postgres instances; adjust for staging/prod)
DATABASE_URL="postgresql://admin:admin@localhost:5434/inventory"

# NextAuth
NEXTAUTH_URL="http://localhost:4200"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# App
APP_URL="http://localhost:4200"
NEXT_PUBLIC_APP_URL="http://localhost:4200"

# AI — routed through the Vercel AI Gateway (see lib/ai/provider.ts). Not
# needed when deployed on Vercel, which authenticates via OIDC automatically;
# required for local dev. Get one from vercel.com/dashboard -> AI Gateway.
AI_GATEWAY_API_KEY=""

# Operator token for the HTTP MCP endpoint (pages/api/mcp.ts). It can act as any
# member of any team, so leave it empty unless trusted infrastructure needs it;
# teams connect with their own API keys instead. At least 32 random characters,
# e.g. `openssl rand -hex 32`.
MCP_SERVER_TOKEN=""

# Autonomous agent guardrails (see lib/ai/policy.ts) — hard ceiling regardless
# of per-team AgentPolicy configuration.
AGENT_MAX_AUTO_REORDER_AMOUNT="2000"

# ── Humlens apps working together ────────────────────────────────────────────
# Same value in Commerce, Inventory and Procurement: lets people move between
# the apps without signing in again (32+ random characters, e.g. `openssl rand -hex 32`).
HUMLENS_SSO_SECRET=
# Where each app lives; shown as links in the other apps' menus.
NEXT_PUBLIC_HUMLENS_INVENTORY_URL=http://localhost:4200
NEXT_PUBLIC_HUMLENS_PROCUREMENT_URL=http://localhost:4100
NEXT_PUBLIC_HUMLENS_COMMERCE_URL=http://localhost:3000
# Background jobs (sync, message delivery, reservation expiry) run inside the
# server process. Set to 1 on serverless hosting and use a cron instead.
DISABLE_SCHEDULER=
# Encrypts other apps' API keys stored in Settings → Integrations (defaults to
# NEXTAUTH_SECRET; changing it means re-entering them).
CONNECTIONS_SECRET=

# ── Local model (optional) ───────────────────────────────────────────────────
# Run the agents on a model you host: Ollama, LM Studio or vLLM, through their
# OpenAI-compatible API. Then set AGENT_MODEL="local/<model>", e.g. local/gemma4
# (pull it first: `ollama pull gemma4`). Teams can also pick it in
# Settings → Agent policy with their own server address.
LOCAL_AI_URL=
# Only for servers that require a key (e.g. vLLM started with --api-key).
LOCAL_AI_API_KEY=

# Outbound requests to addresses set in the app (connected apps, a local model
# server, PunchOut, accounting) never go to link-local/cloud-metadata
# addresses. Set to 1 when one deployment hosts many teams, to also refuse
# private and loopback addresses (localhost, 10.x, 192.168.x).
BLOCK_PRIVATE_OUTBOUND=
